@model IEnumerable<HW_4.Models.Car>

@{
    ViewData["Title"] = "Booked Cars";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Booked Cars</h2>
    <a asp-controller="Cars" asp-action="Index" class="btn btn-secondary">Back to Cars</a>
</div>

@if (Model == null || !Model.Any())
{
    <!-- Empty State Alert -->
    <div class="alert alert-info text-center" role="alert">
        No cars have been booked yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Car Name</th>
                    <th>Price Per Day</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var car in Model)
                {
                    <tr>
                        <td>@car.Id</td>
                        <td>@car.Name</td>
                        <td>PKR @car.PricePerDay</td>
                        <td>
                            <span class="badge bg-warning text-dark">Booked</span>
                        </td>
                        <td>
                            <form asp-controller="Cars" asp-action="Unbook" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@car.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}