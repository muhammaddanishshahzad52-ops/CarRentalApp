@model IEnumerable<HW_4.Models.Car>

@{
    ViewData["Title"] = "Available Cars";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Available Cars</h2>
    </div>
    <p class="text-muted">Select a car from the available list below to complete your booking.</p>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center" role="alert">
        No cars are currently available for booking.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var car in Model)
        {
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">@car.Name</h5>
                        <span class="badge bg-success">Available</span>
                    </div>
                    <p class="card-text text-muted mb-4">
                        <strong>Price:</strong> PKR @car.PricePerDay / day
                    </p>
                    <form asp-controller="Cars" asp-action="Book" method="post" class="mt-auto">
                        <input type="hidden" name="id" value="@car.Id" />
                        <button type="submit" class="btn btn-primary w-100">Book Car</button>
                    </form>
                </div>
            </div>
        }
     </div>
}